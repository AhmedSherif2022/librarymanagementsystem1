# Copy this file to ".env" (same folder as docker-compose.yml) and fill in the values.
# NEVER commit ".env" to GitHub.
DB_PASSWORD=choose-a-strong-password
# Generate with:  openssl rand -base64 32
JWT_SECRET=paste-a-base64-secret-here
# Admin account created on startup (or an existing account made admin). Password: 8 to 72 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_EMAIL=admin@example.com
